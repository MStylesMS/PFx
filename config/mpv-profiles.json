{
  "profiles": {
    "pi4": {
      "name": "Raspberry Pi 4",
      "description": "Pi4 with safer hardware acceleration to avoid blue screen issues",
      "tested": true,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=auto-copy",
        "--vo=gpu",
        "--cache=yes",
        "--demuxer-max-bytes=32M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [],
        "x11": []
      },
      "performance": {
        "profile": null,
        "extraArgs": []
      },
      "notes": "Pi4 uses auto-copy hardware decoding to avoid DRM/blue screen issues. Copies decoded frames to system RAM for GPU compositing."
    },
    "pi4-sw": {
      "name": "Raspberry Pi 4 - Software",
      "description": "Pi4 with software decoding for maximum reliability (tested Oct 2025)",
      "tested": true,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=no",
        "--vo=gpu",
        "--cache=no",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [],
        "x11": []
      },
      "performance": {
        "profile": null,
        "extraArgs": [
          "--video-sync=audio",
          "--framedrop=vo"
        ]
      },
      "notes": "Software decoding tested on Pi4 Rev 1.1 - delivers 0 dropped frames vs 23% with hardware decode. CPU usage ~80% but perfectly smooth playback. Hardware decoder (v4l2m2m) has reliability issues on some Pi4 units."
    },
    "pi5": {
      "name": "Raspberry Pi 5",
      "description": "Optimized settings for Pi5 with dual HDMI and hardware acceleration (X11 compatible)",
      "tested": true,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=auto",
        "--vo=gpu",
        "--cache=yes",
        "--demuxer-max-bytes=50M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [],
        "x11": []
      },
      "performance": {
        "profile": null,
        "extraArgs": []
      },
      "notes": "Pi5 optimized without DRM context for compatibility with multi-screen setups."
    },
    "pi3": {
      "name": "Raspberry Pi 3",
      "description": "Conservative settings for Pi3 with limited hardware acceleration",
      "tested": false,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=auto",
        "--vo=gpu",
        "--cache=yes",
        "--demuxer-max-bytes=16M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [],
        "x11": []
      },
      "performance": {
        "profile": "fast",
        "extraArgs": [
          "--video-sync=audio",
          "--opengl-swapinterval=0"
        ]
      },
      "notes": "Pi3 has limited GPU capabilities. Smaller buffers and aggressive performance settings."
    },
    "pi3-sw": {
      "name": "Raspberry Pi 3 - Software",
      "description": "Pi3 with software decoding and aggressive optimizations for weaker CPU",
      "tested": false,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=no",
        "--vo=gpu",
        "--cache=no",
        "--demuxer-max-bytes=8M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [],
        "x11": []
      },
      "performance": {
        "profile": null,
        "extraArgs": [
          "--video-sync=audio",
          "--framedrop=vo",
          "--opengl-swapinterval=0",
          "--vd-lavc-threads=2"
        ]
      },
      "notes": "Software decoding optimized for Pi3's quad-core A53. Uses minimal cache, aggressive frame dropping, 2 decode threads. May struggle with 1080p - consider 720p content. Based on successful pi4-sw profile."
    },
    "pi-zero": {
      "name": "Raspberry Pi Zero/Zero W",
      "description": "Minimal settings for Pi Zero with software decoding",
      "tested": false,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=no",
        "--vo=gpu",
        "--cache=yes",
        "--demuxer-max-bytes=8M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [
          "--vo=x11"
        ],
        "x11": [
          "--vo=x11"
        ]
      },
      "performance": {
        "profile": "fast",
        "extraArgs": [
          "--video-sync=audio",
          "--framedrop=vo",
          "--opengl-swapinterval=0",
          "--vd-lavc-threads=1"
        ]
      },
      "notes": "Pi Zero has very limited CPU/GPU. Software decoding only, aggressive frame dropping."
    },
    "generic-linux": {
      "name": "Generic Linux Desktop",
      "description": "Standard settings for typical Linux desktop with modern GPU",
      "tested": false,
      "fullscreen": true,
      "baseArgs": [
        "--hwdec=auto",
        "--vo=gpu",
        "--cache=yes",
        "--demuxer-max-bytes=100M",
        "--no-terminal",
        "--no-osc",
        "--keep-open=always"
      ],
      "displayArgs": {
        "wayland": [
          "--vo=gpu",
          "--gpu-context=wayland"
        ],
        "x11": [
