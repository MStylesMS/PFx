          "--gpu-context=x11"
        ]
      },
      "performance": {
        "profile": "gpu-hq",
        "extraArgs": [
          "--video-sync=display-resample",
          "--interpolation"
        ]
      },
      "notes": "Assumes modern hardware with good GPU and plenty of memory. High quality settings."
    },
